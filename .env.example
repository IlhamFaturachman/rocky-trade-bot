# Rocky PolyClaw Trader - Environment Variables
# Copy to .env and fill in your values

# ── Trading Mode ─────────────────────────────────────────────────────────────
# "paper" = simulated trades with real market data
# "live"  = real money trades on Polymarket
TRADING_MODE=paper

# ── Polymarket Wallet (required for live trading) ────────────────────────────
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=1
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=


# ── Risk Parameters (optional overrides) ─────────────────────────────────────
# ROCKY_MAX_RISK_PCT=0.20
# ROCKY_MIN_CONFIDENCE=0.65
# ROCKY_MAX_CONSECUTIVE_LOSSES=3
# ROCKY_DAILY_LOSS_LIMIT=0.40
# ROCKY_STARTING_BALANCE=5.00
# ROCKY_LOOP_INTERVAL=300

# ── Decision Engine ──────────────────────────────────────────────────────────
# "v1" = rule-based (no API key needed)
# "v2" = Opus 4.6 LLM-powered (requires LLM_API_KEY)
ROCKY_ENGINE=v1

# ── LLM API (required for v2 engine — OpenAI-compatible) ─────────────────────
# enowX Labs endpoint (remote VPS)
LLM_API_URL=https://api.enowxlabs.com/v1/chat/completions
# For local OpenClaw gateway proxy, use:
# LLM_API_URL=http://localhost:1430/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=enowxlabs/claude-opus-4.6
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# ── SearXNG (local instance for news search) ─────────────────────────────────
SEARXNG_URL=http://127.0.0.1:8888

# ── Timezone ─────────────────────────────────────────────────────────────────
# UTC offset in hours (e.g., 7 for GMT+7, -5 for EST, 0 for UTC)
ROCKY_TIMEZONE_OFFSET=0

# ── Telegram Notifications ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to "true" to get notifications on skipped cycles (noisy)
# ROCKY_NOTIFY_SKIPS=false

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
